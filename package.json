{
  "name": "infobroker",
  "version": "2026.10.28",
  "description": "Infobroker MCP Server — multi-provider research & writing backend",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "infobroker": "bin/infobroker.js"
  },
  "mcpName": "io.github.flukeatzerocool/infobroker",
  "homepage": "https://github.com/flukeatzerocool/infobroker#readme",
  "bugs": {
    "url": "https://github.com/flukeatzerocool/infobroker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flukeatzerocool/infobroker.git"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin",
    "config.json",
    "skills",
    "instructions"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run check-pack",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint infobroker.md",
    "test": "vitest run",
    "test-skills": "bash scripts/test-skills.sh",
    "test-research": "bash scripts/test-research.sh",
    "test-debate-club": "npx tsc -p debate-club/tsconfig.json && bash debate-club/run.sh arena",
    "validate-spec": "npx tsx scripts/validate-spec.ts",
    "validate-readme": "npx tsx scripts/validate-readme.ts",
    "validate-report": "npx tsx scripts/validate-report.ts",
    "check-report-fixtures": "npx tsx scripts/check-report-fixtures.ts",
    "check-script-discipline": "npx tsx scripts/check-script-discipline.ts",
    "check-tdqs": "npx tsx scripts/check-tdqs.ts",
    "check-intent-citations": "npx tsx scripts/check-intent-citations.ts",
    "check-harness-expectations": "npx tsx scripts/check-harness-expectations.ts",
    "check-gate-coverage": "npx tsx scripts/check-gate-coverage.ts",
    "check-pack": "npx tsx scripts/check-pack.ts",
    "check-skill-harness": "node --test scripts/test-skills/checks.test.mjs scripts/test-skills/event-stream.test.mjs",
    "check-fixtures": "npx tsx scripts/check-fixture-freshness.ts",
    "generate-auth": "npx tsx scripts/generate-provider-auth.ts",
    "generate-privacy": "npx tsx scripts/generate-provider-privacy.ts",
    "generate-provider-map": "npx tsx scripts/generate-provider-map.ts",
    "version-bump": "npx tsx scripts/version.ts bump",
    "version-sync": "npx tsx scripts/version.ts check",
    "audit": "npm audit --audit-level=high",
    "push": "bash scripts/push-pipeline.sh",
    "check": "npm run typecheck && npm run version-sync && npm run validate-spec && npm run validate-readme && npm run check-report-fixtures && npm run check-script-discipline && npm run check-tdqs && npm run check-intent-citations && npm run check-harness-expectations && npm run check-gate-coverage && npm run check-skill-harness && npm run test && npm run check-pack && npm run test-debate-club && npm run audit && npx tsx scripts/check-shipped-kb-empty.ts",
    "render-report": "npx tsx scripts/render-report.ts",
    "benchmark-retrieval": "npx tsx scripts/benchmark-retrieval.ts",
    "benchmark-kb": "npx tsx scripts/benchmark-kb-store.ts",
    "monitor-delta": "npx tsx scripts/monitor-delta.ts",
    "monitor-watchlist": "npx tsx scripts/monitor-watchlist.ts"
  },
  "keywords": [
    "search",
    "research",
    "mcp",
    "infobroker"
  ],
  "author": "Infobroker",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.0.0",
    "tldts": "^7.4.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "js-yaml": "^5.2.3",
    "markdownlint-cli": "^0.50.0",
    "marked": "^18.1.2",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "markdownlint": {
      "re2js": "^2.9.1"
    },
    "markdownlint-cli": {
      "minimatch": "^11.0.1"
    }
  }
}
