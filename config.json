{
  "defaults": {
    "timeout": 12000,
    "retry_count": 2,
    "retry_backoff_ms": 1000
  },
  "providers": {
    "duckduckgo": {
      "tier": "builtin",
      "capabilities": ["web_search", "suggest"],
      "rate_limit": { "per_second": 0.33 },
      "enabled": true,
      "priority": 10,
      "timeout": 10000,
      "resells": true
    },
    "jina": {
      "tier": "free_http",
      "capabilities": ["content_fetch"],
      "rate_limit": { "per_second": 1 },
      "enabled": true,
      "priority": 10,
      "timeout": 15000,
      "retry_backoff_ms": 1000
    },
    "wikipedia": {
      "tier": "free_http",
      "capabilities": ["encyclopedia"],
      "rate_limit": { "per_second": 5 },
      "enabled": true,
      "priority": 20
    },
    "wiktionary": {
      "tier": "free_http",
      "capabilities": ["encyclopedia", "definition"],
      "rate_limit": { "per_second": 5 },
      "enabled": true,
      "priority": 20
    },
    "wikidata": {
      "tier": "free_http",
      "capabilities": ["structured_fact"],
      "rate_limit": { "per_second": 5 },
      "enabled": true,
      "priority": 20
    },
    "openstreetmap": {
      "tier": "free_http",
      "capabilities": ["location"],
      "rate_limit": { "per_second": 1 },
      "enabled": true,
      "priority": 20
    },
    "internet_archive": {
      "tier": "free_http",
      "capabilities": ["archive"],
      "rate_limit": { "per_second": 1 },
      "enabled": true,
      "priority": 20,
      "timeout": 15000
    },
    "arxiv": {
      "tier": "free_http",
      "capabilities": ["academic"],
      "rate_limit": { "per_second": 0.33 },
      "enabled": true,
      "priority": 15,
      "timeout": 15000
    },
    "semantic_scholar": {
      "tier": "free_http",
      "capabilities": ["academic"],
      "rate_limit": { "per_second": 1 },
      "auth_env": "INFOBROKER_SEMANTIC_SCHOLAR_API_KEY",
      "enabled": true,
      "priority": 25
    },
    "stack_exchange": {
      "tier": "free_http",
      "capabilities": ["code"],
      "rate_limit": { "per_second": 0.003 },
      "auth_env": "INFOBROKER_STACK_EXCHANGE_API_KEY",
      "enabled": true,
      "priority": 15
    },
    "github": {
      "tier": "free_http",
      "capabilities": ["code"],
      "rate_limit": { "per_second": 0.017 },
      "auth_env": "INFOBROKER_GITHUB_API_KEY",
      "enabled": true,
      "priority": 15
    },
    "core": {
      "tier": "free_http",
      "capabilities": ["academic"],
      "rate_limit": { "per_second": 1 },
      "auth_env": "INFOBROKER_CORE_API_KEY",
      "enabled": true,
      "priority": 15
    },
    "marginalia": {
      "tier": "builtin",
      "capabilities": ["web_search", "small_web"],
      "rate_limit": { "per_second": 0.2 },
      "enabled": true,
      "priority": 5,
      "timeout": 30000,
      "resells": true
    },
    "mojeek": {
      "tier": "builtin",
      "capabilities": ["web_search"],
      "rate_limit": { "per_second": 0.2 },
      "enabled": true,
      "priority": 5,
      "timeout": 30000,
      "resells": true
    },
    "wiby": {
      "tier": "builtin",
      "capabilities": ["web_search", "small_web"],
      "rate_limit": { "per_second": 0.2 },
      "enabled": true,
      "priority": 5,
      "timeout": 30000,
      "resells": true
    },
    "brave": {
      "tier": "keyed_http",
      "capabilities": ["web_search", "news", "semantic"],
      "rate_limit": { "per_month": 2000 },
      "auth_env": "INFOBROKER_BRAVE_API_KEY",
      "enabled": false,
      "priority": 30,
      "resells": true
    },
    "exa": {
      "tier": "keyed_http",
      "capabilities": ["semantic", "synthesis"],
      "rate_limit": { "per_month": 1000 },
      "auth_env": "INFOBROKER_EXA_API_KEY",
      "enabled": false,
      "priority": 30,
      "resells": true
    },
    "tavily": {
      "tier": "keyed_http",
      "capabilities": ["synthesis"],
      "rate_limit": { "per_month": 1000 },
      "auth_env": "INFOBROKER_TAVILY_API_KEY",
      "enabled": false,
      "priority": 30,
      "resells": true
    },
    "searxng": {
      "tier": "self_hosted_http",
      "capabilities": ["web_search", "privacy_critical"],
      "rate_limit": {},
      "url_env": "INFOBROKER_SEARXNG_URL",
      "enabled": false,
      "priority": 40,
      "resells": true
    },
    "yep": {
      "tier": "keyed_http",
      "capabilities": ["web_search", "semantic", "synthesis"],
      "rate_limit": { "per_month": 1000 },
      "auth_env": "INFOBROKER_YEP_API_KEY",
      "enabled": false,
      "priority": 30,
      "resells": true
    },
    "native_fetch": {
      "tier": "builtin",
      "capabilities": ["content_fetch"],
      "rate_limit": {},
      "enabled": true,
      "priority": 1,
      "timeout": 30000
    }
  },
  "dispatch": {
    "general_web": ["brave", "duckduckgo", "marginalia", "mojeek"],
    "small_web": ["marginalia", "mojeek", "wiby", "duckduckgo"],
    "encyclopedia": ["wikipedia", "duckduckgo"],
    "definition": ["wiktionary", "duckduckgo"],
    "structured_fact": ["wikidata", "wikipedia", "duckduckgo"],
    "location": ["openstreetmap", "wikipedia", "duckduckgo"],
    "academic": ["semantic_scholar", "arxiv"],
    "code": ["stack_exchange", "github", "duckduckgo"],
    "news": ["brave", "duckduckgo"],
    "archive": ["internet_archive", "duckduckgo"],
    "semantic": ["exa", "brave", "duckduckgo"],
    "synthesis": ["tavily", "exa", "duckduckgo"],
    "privacy_critical": ["duckduckgo", "searxng", "mojeek"],
    "content_fetch": ["jina", "native_fetch"]
  },
  "corroboration": {
    "max_iterations": 5,
    "max_http_calls": 30,
    "confidence_threshold": 0.8,
    "first_pass_max_results": 10,
    "similarity_threshold": 0.3,
    "archive_sources": false,
    "authority_weights": {
      "academic": 1.0,
      "encyclopedia": 1.0,
      "archive": 1.0,
      "structured_fact": 1.0,
      "definition": 1.0,
      "location": 1.0,
      "code": 0.9,
      "semantic": 0.9,
      "synthesis": 0.9,
      "news": 0.8,
      "web_search": 0.7
    }
  },
  "output": {
    "max_chars": 50000,
    "latency_window_size": 100,
    "verbose": true,
    "fallback_depth": 3,
    "max_redirect_hops": 5,
    "degraded_latency_ms": 2000
  },
  "kb": {
    "storage_path": "~/.local/share/infobroker/knowledge-base",
    "embedding_model": "signed-hash-tfidf",
    "chunk_size": 1024,
    "chunk_overlap": 64,
    "auto_index": true,
    "default_collection": "default",
    "max_results": 50,
    "reports_dir": "~/Infobroker/reports",
    "default_save_destination": "kb",
    "freshness": {
      "tiers": {
        "ephemeral": { "decay_hours": 24, "expiry_hours": 168 },
        "recent": { "decay_hours": 168, "expiry_hours": 720 },
        "stable": { "decay_hours": 720, "expiry_hours": 0 },
        "evergreen": { "decay_hours": 0, "expiry_hours": 0 },
        "report": { "decay_hours": 720, "expiry_hours": 0 }
      },
      "auto_classify": true,
      "default_tier": "stable"
    },
    "kb_first_relevance_threshold": 0.3,
    "kb_first_confidence_threshold": 0.5,
    "maintenance_interval_minutes": 60
  }
}
