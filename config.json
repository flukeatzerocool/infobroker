{
  "providers": {
    "duckduckgo": {
      "type": "scraped",
      "tier": "builtin",
      "capabilities": ["web_search", "suggest"],
      "rate_limit": { "per_second": 0.33 },
      "enabled": true,
      "priority": 10,
      "timeout": 10000
    },
    "jina": {
      "type": "free_http",
      "tier": "free_http",
      "capabilities": ["content_fetch"],
      "rate_limit": { "per_second": 1 },
      "enabled": true,
      "priority": 10,
      "timeout": 15000
    },
    "wikipedia": {
      "type": "free_http",
      "tier": "free_http",
      "capabilities": ["encyclopedia"],
      "rate_limit": { "per_second": 5 },
      "enabled": true,
      "priority": 20,
      "timeout": 10000
    },
    "wiktionary": {
      "type": "free_http",
      "tier": "free_http",
      "capabilities": ["encyclopedia", "definition"],
      "rate_limit": { "per_second": 5 },
      "enabled": true,
      "priority": 20,
      "timeout": 10000
    },
    "wikidata": {
      "type": "free_http",
      "tier": "free_http",
      "capabilities": ["structured_fact"],
      "rate_limit": { "per_second": 5 },
      "enabled": true,
      "priority": 20,
      "timeout": 10000
    },
    "openstreetmap": {
      "type": "free_http",
      "tier": "free_http",
      "capabilities": ["location"],
      "rate_limit": { "per_second": 1 },
      "enabled": true,
      "priority": 20,
      "timeout": 10000
    },
    "internet_archive": {
      "type": "free_http",
      "tier": "free_http",
      "capabilities": ["archive"],
      "rate_limit": { "per_second": 1 },
      "enabled": true,
      "priority": 20,
      "timeout": 15000
    },
    "arxiv": {
      "type": "free_http",
      "tier": "free_http",
      "capabilities": ["academic"],
      "rate_limit": { "per_second": 0.33 },
      "enabled": true,
      "priority": 15,
      "timeout": 15000
    },
    "semantic_scholar": {
      "type": "free_http",
      "tier": "free_http",
      "capabilities": ["academic"],
      "rate_limit": { "per_second": 1 },
      "auth_env": "INFOBROKER_SEMANTIC_SCHOLAR_API_KEY",
      "enabled": true,
      "priority": 25,
      "timeout": 10000
    },
    "stack_exchange": {
      "type": "free_http",
      "tier": "free_http",
      "capabilities": ["code"],
      "rate_limit": { "per_second": 0.003 },
      "auth_env": "INFOBROKER_STACK_EXCHANGE_API_KEY",
      "enabled": true,
      "priority": 15,
      "timeout": 10000
    },
    "github": {
      "type": "free_http",
      "tier": "free_http",
      "capabilities": ["code"],
      "rate_limit": { "per_second": 0.017 },
      "auth_env": "INFOBROKER_GITHUB_API_KEY",
      "enabled": true,
      "priority": 15,
      "timeout": 10000
    },
    "core": {
      "type": "free_http",
      "tier": "free_http",
      "capabilities": ["academic"],
      "rate_limit": { "per_second": 1 },
      "auth_env": "INFOBROKER_CORE_API_KEY",
      "enabled": true,
      "priority": 15,
      "timeout": 10000
    },
    "marginalia": {
      "type": "scraped",
      "tier": "builtin",
      "capabilities": ["web_search", "small_web"],
      "rate_limit": { "per_second": 0.2 },
      "enabled": true,
      "priority": 5,
      "timeout": 30000
    },
    "mojeek": {
      "type": "scraped",
      "tier": "builtin",
      "capabilities": ["web_search"],
      "rate_limit": { "per_second": 0.2 },
      "enabled": true,
      "priority": 5,
      "timeout": 30000
    },
    "brave": {
      "type": "keyed_http",
      "tier": "keyed_http",
      "capabilities": ["web_search", "news", "semantic"],
      "rate_limit": { "per_month": 2000 },
      "auth_env": "INFOBROKER_BRAVE_API_KEY",
      "enabled": true,
      "priority": 30,
      "timeout": 10000
    },
    "exa": {
      "type": "keyed_http",
      "tier": "keyed_http",
      "capabilities": ["semantic", "synthesis"],
      "rate_limit": { "per_month": 1000 },
      "auth_env": "INFOBROKER_EXA_API_KEY",
      "enabled": true,
      "priority": 30,
      "timeout": 10000
    },
    "tavily": {
      "type": "keyed_http",
      "tier": "keyed_http",
      "capabilities": ["synthesis"],
      "rate_limit": { "per_month": 1000 },
      "auth_env": "INFOBROKER_TAVILY_API_KEY",
      "enabled": true,
      "priority": 30,
      "timeout": 10000
    },
    "searxng": {
      "type": "self_hosted_http",
      "tier": "self_hosted_http",
      "capabilities": ["web_search", "privacy_critical"],
      "rate_limit": {},
      "url_env": "INFOBROKER_SEARXNG_URL",
      "enabled": false,
      "priority": 40,
      "timeout": 10000
    },
    "native_fetch": {
      "type": "builtin",
      "tier": "builtin",
      "capabilities": ["content_fetch"],
      "rate_limit": {},
      "enabled": true,
      "priority": 1,
      "timeout": 30000
    }
  },
  "dispatch": {
    "general_web": ["brave", "duckduckgo", "marginalia", "mojeek"],
    "small_web": ["marginalia", "mojeek", "duckduckgo"],
    "encyclopedia": ["wikipedia", "duckduckgo"],
    "definition": ["wiktionary", "duckduckgo"],
    "structured_fact": ["wikidata", "wikipedia", "duckduckgo"],
    "location": ["openstreetmap", "wikipedia", "duckduckgo"],
    "academic": ["semantic_scholar", "arxiv"],
    "code": ["stack_exchange", "github", "duckduckgo"],
    "news": ["brave", "duckduckgo"],
    "archive": ["internet_archive", "duckduckgo"],
    "semantic": ["exa", "brave", "duckduckgo"],
    "synthesis": ["tavily", "exa", "duckduckgo"],
    "privacy_critical": ["duckduckgo"],
    "content_fetch": ["jina", "native_fetch"]
  },
  "convergence": {
    "max_iterations": 5,
    "max_http_calls": 30,
    "confidence_threshold": 0.8
  },
  "output": {
    "max_chars": 50000,
    "latency_window_size": 100
  },
  "kb": {
    "storage_path": "~/.local/share/infobroker/knowledge-base",
    "embedding_model": "tf-idf",
    "chunk_size": 512,
    "chunk_overlap": 64,
    "auto_index": true,
    "default_collection": "default",
    "max_results": 50,
    "expiry": {
      "web_search": 0,
      "fetch_page": 0,
      "converge": 0
    },
    "maintenance_interval_minutes": 60
  }
}
