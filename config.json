{
  "config_version": 2,
  "defaults": {
    "timeout": 12000,
    "retry_count": 2,
    "retry_backoff_ms": 1000
  },
  "providers": {
    "duckduckgo": {
      "tier": "builtin",
      "capabilities": ["web_search", "suggest"],
      "rate_limit": { "per_second": 0.25, "jitter_ms": 800 },
      "enabled": true,
      "priority": 10,
      "timeout": 10000,
      "resells": true
    },
    "jina": {
      "tier": "free_http",
      "capabilities": ["content_fetch"],
      "rate_limit": { "per_second": 1 },
      "enabled": true,
      "priority": 10,
      "timeout": 15000,
      "retry_backoff_ms": 1000
    },
    "wikipedia": {
      "tier": "free_http",
      "capabilities": ["encyclopedia"],
      "languages": "*",
      "rate_limit": { "per_second": 5 },
      "enabled": true,
      "priority": 20
    },
    "wiktionary": {
      "tier": "free_http",
      "capabilities": ["encyclopedia", "definition"],
      "languages": "*",
      "rate_limit": { "per_second": 5 },
      "enabled": true,
      "priority": 20
    },
    "wikidata": {
      "tier": "free_http",
      "capabilities": ["structured_fact"],
      "languages": "*",
      "rate_limit": { "per_second": 5 },
      "enabled": true,
      "priority": 20
    },
    "openstreetmap": {
      "tier": "free_http",
      "capabilities": ["location"],
      "rate_limit": { "per_second": 1 },
      "enabled": true,
      "priority": 20
    },
    "internet_archive": {
      "tier": "free_http",
      "capabilities": ["archive"],
      "rate_limit": { "per_second": 1 },
      "enabled": true,
      "priority": 20,
      "timeout": 15000
    },
    "arxiv": {
      "tier": "free_http",
      "capabilities": ["academic"],
      "rate_limit": { "per_second": 0.33 },
      "enabled": true,
      "priority": 15,
      "timeout": 15000
    },
    "semantic_scholar": {
      "tier": "free_http",
      "capabilities": ["academic"],
      "rate_limit": { "per_second": 1 },
      "auth_env": "INFOBROKER_SEMANTIC_SCHOLAR_API_KEY",
      "auth_optional": true,
      "enabled": true,
      "priority": 25
    },
    "stack_exchange": {
      "tier": "free_http",
      "capabilities": ["code"],
      "rate_limit": { "per_second": 0.003 },
      "auth_env": "INFOBROKER_STACK_EXCHANGE_API_KEY",
      "auth_optional": true,
      "enabled": true,
      "priority": 15
    },
    "github": {
      "tier": "free_http",
      "capabilities": ["code"],
      "rate_limit": { "per_second": 0.15 },
      "auth_env": "INFOBROKER_GITHUB_API_KEY",
      "auth_optional": true,
      "enabled": true,
      "priority": 15
    },
    "core": {
      "tier": "free_http",
      "capabilities": ["academic"],
      "rate_limit": { "per_second": 1 },
      "auth_env": "INFOBROKER_CORE_API_KEY",
      "enabled": true,
      "priority": 15
    },
    "marginalia": {
      "tier": "builtin",
      "capabilities": ["web_search", "small_web"],
      "rate_limit": { "per_second": 0.2 },
      "enabled": true,
      "priority": 5,
      "timeout": 30000,
      "resells": true
    },
    "mojeek": {
      "tier": "builtin",
      "capabilities": ["web_search"],
      "rate_limit": { "per_second": 0.2 },
      "enabled": true,
      "priority": 5,
      "timeout": 30000,
      "resells": true
    },
    "wiby": {
      "tier": "builtin",
      "capabilities": ["web_search", "small_web"],
      "rate_limit": { "per_second": 0.2 },
      "enabled": true,
      "priority": 5,
      "timeout": 30000,
      "resells": true
    },
    "openalex": {
      "tier": "free_http",
      "capabilities": ["academic"],
      "rate_limit": { "per_second": 1 },
      "enabled": true,
      "priority": 15,
      "timeout": 15000
    },
    "europe_pmc": {
      "tier": "free_http",
      "capabilities": ["academic"],
      "rate_limit": { "per_second": 1 },
      "enabled": true,
      "priority": 15,
      "timeout": 15000
    },
    "crossref": {
      "tier": "free_http",
      "capabilities": ["academic"],
      "rate_limit": { "per_second": 1 },
      "enabled": true,
      "priority": 15,
      "timeout": 15000
    },
    "hacker_news": {
      "tier": "free_http",
      "capabilities": ["news"],
      "rate_limit": { "per_second": 1 },
      "enabled": true,
      "priority": 15,
      "timeout": 15000
    },
    "gdelt": {
      "tier": "free_http",
      "capabilities": ["news"],
      "languages": "*",
      "rate_limit": { "per_second": 0.2 },
      "enabled": true,
      "priority": 15,
      "timeout": 15000
    },
    "sec_edgar": {
      "tier": "free_http",
      "capabilities": ["financial"],
      "rate_limit": { "per_second": 0.2 },
      "enabled": true,
      "priority": 15,
      "timeout": 15000
    },
    "world_bank": {
      "tier": "free_http",
      "capabilities": ["financial"],
      "rate_limit": { "per_second": 1 },
      "enabled": true,
      "priority": 15,
      "timeout": 15000
    },
    "exa": {
      "tier": "keyed_http",
      "capabilities": ["semantic", "synthesis"],
      "rate_limit": { "per_month": 1000 },
      "auth_env": "INFOBROKER_EXA_API_KEY",
      "enabled": false,
      "priority": 30,
      "resells": true
    },
    "tavily": {
      "tier": "keyed_http",
      "capabilities": ["synthesis"],
      "rate_limit": { "per_month": 1000 },
      "auth_env": "INFOBROKER_TAVILY_API_KEY",
      "enabled": false,
      "priority": 30,
      "resells": true
    },
    "searxng": {
      "tier": "self_hosted_http",
      "capabilities": ["web_search", "privacy_critical"],
      "languages": "*",
      "privacy": {
        "query_forwarding": "third_party",
        "notes": "self-hosted instance; upstream engines receive queries unless configured otherwise"
      },
      "rate_limit": {},
      "url_env": "INFOBROKER_SEARXNG_URL",
      "enabled": false,
      "priority": 40,
      "resells": true
    },
    "yep": {
      "tier": "keyed_http",
      "capabilities": ["web_search", "semantic", "synthesis"],
      "languages": "*",
      "rate_limit": { "per_month": 1000 },
      "auth_env": "INFOBROKER_YEP_API_KEY",
      "enabled": false,
      "priority": 30,
      "resells": true
    },
    "native_fetch": {
      "tier": "builtin",
      "capabilities": ["content_fetch"],
      "rate_limit": {},
      "enabled": true,
      "priority": 1,
      "timeout": 30000
    }
  },
  "dispatch": {
    "general_web": ["duckduckgo", "marginalia", "mojeek", "wiby"],
    "small_web": ["marginalia", "mojeek", "wiby", "duckduckgo"],
    "encyclopedia": ["wikipedia", "duckduckgo"],
    "definition": ["wiktionary", "duckduckgo"],
    "structured_fact": ["wikidata", "wikipedia", "duckduckgo"],
    "location": ["openstreetmap", "wikipedia", "duckduckgo"],
    "academic": ["semantic_scholar", "arxiv", "openalex", "europe_pmc", "crossref"],
    "code": ["stack_exchange", "github", "duckduckgo"],
    "news": ["duckduckgo", "gdelt", "hacker_news"],
    "financial": ["sec_edgar", "world_bank", "duckduckgo"],
    "archive": ["internet_archive", "duckduckgo"],
    "semantic": ["exa", "duckduckgo"],
    "synthesis": ["tavily", "exa", "duckduckgo"],
    "privacy_critical": ["duckduckgo", "searxng", "mojeek"],
    "content_fetch": ["jina", "native_fetch"]
  },
  "dispatch_append": {},
  "fetch": {
    "allow_private_urls": false,
    "passage_size": 250,
    "max_passages": 6,
    "detect_date": true,
    "crawl_max_pages": 10,
    "crawl_max_depth": 2,
    "cache": {
      "kb_read": true,
      "kb_max_age_hours": 24
    }
  },
  "expand": {
    "max_expansions": 5
  },
  "research": {
    "max_variants": 3,
    "max_pages_per_variant": 2
  },
  "deep": {
    "max_pages": 3,
    "max_total_pages": 8,
    "concurrency": 4,
    "early_exit_score": 0.3,
    "max_ms": 8000,
    "detect_date": false
  },
  "analysis": {
    "enabled": true,
    "max_topics": 10,
    "max_entities": 10,
    "cluster_threshold": 0.55,
    "min_cluster_size": 2,
    "timeline": true
  },
  "corroboration": {
    "max_iterations": 5,
    "max_http_calls": 30,
    "max_batch_claims": 10,
    "modality_markers": {
      "reported": [
        "reportedly",
        "allegedly",
        "according to",
        "says",
        "said",
        "claims",
        "claimed",
        "is said to",
        "are said to",
        "has reported",
        "reported that",
        "sources say"
      ],
      "speculative": [
        "may",
        "might",
        "could",
        "appears to",
        "appear to",
        "seems to",
        "seem to",
        "possibly",
        "probably",
        "is believed to",
        "are believed to",
        "unconfirmed",
        "expected to"
      ]
    },
    "confidence_threshold": 0.8,
    "first_pass_max_results": 5,
    "first_pass_max_providers": 5,
    "similarity_threshold": 0.3,
    "archive_sources": false,
    "kb_recall": true,
    "family_similarity_threshold": 0.9,
    "calibration": { "enabled": true, "secondary_only_cap": 0.7 },
    "authority_weights": {
      "academic": 1.0,
      "encyclopedia": 1.0,
      "archive": 1.0,
      "structured_fact": 1.0,
      "definition": 1.0,
      "location": 1.0,
      "code": 0.9,
      "semantic": 0.9,
      "synthesis": 0.9,
      "news": 0.8,
      "web_search": 0.7
    }
  },
  "output": {
    "max_chars": 50000,
    "latency_window_size": 100,
    "verbose": true,
    "fallback_depth": 5,
    "max_redirect_hops": 5,
    "degraded_latency_ms": 2000,
    "hedge_enabled": true,
    "hedge_min_delay_ms": 200,
    "hedge_max_delay_ms": 1500,
    "hedge_grace_ms": 300,
    "rate_limit_cooldown_ms": 30000,
    "audit_log_path": "~/.local/share/infobroker/audit.log",
    "call_log": "stderr",
    "call_log_path": "~/.local/share/infobroker/call-log.jsonl",
    "call_log_max_bytes": 2000000
  },
  "source_quality": {
    "enabled": true,
    "weight": 0.15,
    "primary_source_suffixes": [".gov", ".mil", ".edu", ".int"],
    "trusted_domains": [],
    "low_quality_domains": [],
    "blocklist": []
  },
  "content_policy": {
    "mode": "flag",
    "threshold": 0.2,
    "patterns": {
      "prompt_injection": ["ignore previous instructions", "ignore all previous instructions", "disregard prior instructions", "you are now", "system prompt is"],
      "credential_phishing": ["verify your account", "confirm your password", "update your billing", "login credentials"],
      "malware_exploit": ["reverse shell", "exploit code", "payload delivery", "malware download"],
      "adult_content": ["sexually explicit", "adult content"]
    }
  },
  "state": {
    "auto_migrate_config": false,
    "update_check": false
  },
  "kb": {
    "storage_path": "~/.local/share/infobroker/knowledge-base",
    "embedding_model": "signed-hash-tfidf",
    "chunk_size": 1024,
    "chunk_overlap": 64,
    "auto_index": true,
    "default_collection": "default",
    "max_results": 50,
    "reports_dir": "~/.local/share/infobroker/reports",
    "default_save_destination": "kb",
    "freshness": {
      "tiers": {
        "ephemeral": { "decay_hours": 24, "expiry_hours": 168 },
        "recent": { "decay_hours": 168, "expiry_hours": 720 },
        "stable": { "decay_hours": 720, "expiry_hours": 0 },
        "evergreen": { "decay_hours": 0, "expiry_hours": 0 },
        "report": { "decay_hours": 720, "expiry_hours": 0 }
      },
      "auto_classify": true,
      "default_tier": "stable"
    },
    "kb_first_relevance_threshold": 0.3,
    "kb_first_confidence_threshold": 0.5,
    "maintenance_interval_minutes": 60,
    "keys_dir": "~/.local/share/infobroker/keys"
  },
  "preservation": {
    "enabled": true,
    "max_sources_per_finding": 3,
    "max_bytes": 2000000
  }
}
