#!/usr/bin/env bash
# pre-push — gate: run the full check suite before any ref leaves the machine.
#
# Exit codes: 0 = checks passed (or this exact tree was already verified),
# 1 = checks failed or node is missing, 2 = fatal/unexpected.
#
# The gate runner records a full-suite pass keyed on the commit's tree object
# plus a clean working tree (`.infobroker/gate-run.json`, local and never
# committed). The push pipeline writes that record after committing; a manual
# `npm run check` on a clean tree writes it too. When the record covers the
# current tree, the suite has already run on exactly these objects, so
# re-running it per ref (branch, tag, mirror) only duplicates work. A stale
# record, a dirty tree, a `fast`-only record, or CI always runs the suite.
set -euo pipefail

if ! command -v node >/dev/null 2>&1; then
    echo "ERROR: node is required to run pre-push checks but was not found in PATH"
    exit 1
fi

if [[ -z "${CI:-}" ]]; then
    recorded="$(npx tsx scripts/run-gates.ts --recorded 2>/dev/null || echo none)"
    if [[ "$recorded" == "full" ]]; then
        echo "Pre-push checks skipped: the full suite is recorded for this exact tree."
        exit 0
    fi
fi

echo "Running pre-push checks..."
echo "  version sync..."
npm run version-sync

echo "  gate suite..."
npm run check

echo "Pre-push checks passed."
