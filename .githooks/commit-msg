#!/usr/bin/env bash
# commit-msg — gate: reject an over-long or period-terminated subject line.
#
# Client-side hooks are fast feedback, not a guarantee: `git commit --no-verify`
# bypasses this. The durable checks stay in `npm run check` and the pipeline.
#
# Exit codes: 0 = pass, 1 = subject rejected, 2 = fatal.
set -euo pipefail

msg_file="${1:?commit-msg: commit message file required}"
subject=$(head -n 1 "$msg_file")

# Merge and revert subjects are generated by git; leave them alone.
case "$subject" in
    Merge\ *|Revert\ *|"") exit 0 ;;
esac

if (( ${#subject} > 72 )); then
    printf 'commit-msg: subject is %d characters (max 72).\n' "${#subject}" >&2
    printf '  %s\n' "$subject" >&2
    exit 1
fi

if [[ "$subject" == *. ]]; then
    printf 'commit-msg: subject must not end with a period.\n' >&2
    printf '  %s\n' "$subject" >&2
    exit 1
fi

exit 0
